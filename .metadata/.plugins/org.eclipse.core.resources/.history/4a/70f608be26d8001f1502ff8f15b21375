/**
 * @brief UART receive complete callback.
 *
 * This function is called when a UART receive interrupt is triggered. It processes the incoming character,
 * appends it to the appropriate command buffer, and sets the corresponding ready flag when a newline ('\n')
 * or carriage return ('\r') is received, indicating the end of a command.
 *
 * Behavior:
 * - Handles interrupts for USART1, USART2, and USART3 separately.
 * - Adds characters to the appropriate buffer until a complete command is detected.
 * - Resets the buffer index when the buffer overflows or a command is completed.
 * - Re-enables the UART receive interrupt after processing each character.
 *
 * @param huart Pointer to the UART handle that triggered the interrupt.
 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    // Static variables to maintain the buffer indices for each UART
    static uint8_t rx_index1 = 0, rx_index2 = 0, rx_index3 = 0;

    // Check which UART triggered the interrupt
    if (huart->Instance == USART1) {
        // Handle received character for USART1
        char received_char = rx_buffer1[0];
        if (received_char == '\n' || received_char == '\r') {
            // Command complete; null-terminate the buffer and set the ready flag
            command_buffer1[rx_index1] = '\0';
            command_ready_flag1 = 1;
            rx_index1 = 0; // Reset the index for the next command
        } else if (rx_index1 < RX_BUFFER_SIZE - 1) {
            // Append the character to the buffer if there's space
            command_buffer1[rx_index1++] = received_char;
        }
        // Re-enable UART receive interrupt for USART1
        HAL_UART_Receive_IT(&huart1, (uint8_t *)rx_buffer1, 1);

    } else if (huart->Instance == USART2) {
        // Handle received character for USART2
        char received_char = rx_buffer2[0];
        if (received_char == '\n' || received_char == '\r') {
            // Command complete; null-terminate the buffer and set the ready flag
            command_buffer2[rx_index2] = '\0';
            command_ready_flag2 = 1;
            rx_index2 = 0; // Reset the index for the next command
        } else if (rx_index2 < RX_BUFFER_SIZE - 1) {
            // Append the character to the buffer if there's space
            command_buffer2[rx_index2++] = received_char;
        }
        // Re-enable UART receive interrupt for USART2
        HAL_UART_Receive_IT(&huart2, (uint8_t *)rx_buffer2, 1);

    } else if (huart->Instance == USART3) {
        // Handle received character for USART3
        char received_char = rx_buffer3[0];
        if (received_char == '\n' || received_char == '\r') {
            // Command complete; null-terminate the buffer and set the ready flag
            command_buffer3[rx_index3] = '\0';
            command_ready_flag3 = 1;
            rx_index3 = 0; // Reset the index for the next command
        } else if (rx_index3 < RX_BUFFER_SIZE - 1) {
            // Append the character to the buffer if there's space
            command_buffer3[rx_index3++] = received_char;
        }
        // Re-enable UART receive interrupt for USART3
        HAL_UART_Receive_IT(&huart3, (uint8_t *)rx_buffer3, 1);
    }
}



/**
 * @brief Configures GPIO pins for input or output based on the command.
 *
 * This function parses a command string to identify and configure GPIO pins as either input or output.
 * It validates the provided command for the correct format and range of pins. If the command specifies
 * output pins, their state is set accordingly.
 *
 * Function behavior:
 * - For "d <pins>": Configures the specified pins as input.
 * - For "sX <pins>": Configures the pins as output and sets their state based on X ('1' for HIGH, '0' for LOW).
 * - Provides error feedback for invalid commands or pin configurations.
 *
 * Return Values:
 * - `1`: Successfully configured pins.
 * - `-1`: Invalid state provided in the command (e.g., non-'0' or non-'1' for output state).
 * - `-2`: Unrecognized command prefix (neither 'd' nor 's').
 * - `-3`: Invalid port, format, or pin.
 * - `-4`: Invalid pin number (out of range 0-15).
 *
 * @param huart   UART handle for transmitting confirmation or error messages.
 * @param command The command string specifying the operation and pins (e.g., "d PA3 PB5").
 * @return int    Status code indicating the result of the operation.
 */
int configure_pins(UART_HandleTypeDef *huart, char *command)
{
    uint8_t *num_pins = NULL;           // Pointer to track the number of configured pins
    void *pins_array = NULL;            // Pointer to the target pins array
    const char *operation = NULL;       // Operation type (Input or Output)
    uint8_t max_pins = 0;               // Maximum pins allowed for the operation
    char state = '\0';                  // State for output pins (used for `s` commands)

    // Determine the type of configuration based on the command prefix
    if (strncmp(command, "d ", 2) == 0) {
        num_pins = &num_input_pins;
        pins_array = input_pins;
        operation = "Input";
        max_pins = MAX_INPUT_PINS;
        command += 2; // Skip "d " prefix
    } else if (strncmp(command, "s", 1) == 0) {
        num_pins = &num_output_pins;
        pins_array = output_pins;
        operation = "Output";
        max_pins = MAX_OUTPUT_PINS;
        state = command[1]; // Extract state ('1' or '0')

        // Validate state
        if (state != '1' && state != '0') {
            HAL_UART_Transmit(huart, (uint8_t *)"Invalid State\n", 15, HAL_MAX_DELAY);
            return -1;
        }
        command += 2; // Skip "sX " prefix
    } else {
        // Unknown command
        HAL_UART_Transmit(huart, (uint8_t *)"Unknown Command\n", 17, HAL_MAX_DELAY);
        return -2;
    }

    // Reset the pin list for the operation
    *num_pins = 0;

    // Tokenize the command to extract pin configurations
    char *token = strtok(command, " ");
    while (token && *num_pins < max_pins) {
        // Validate port and pin format
        if ((strncmp(token, "PA", 2) != 0 && strncmp(token, "PB", 2) != 0 && strncmp(token, "PC", 2) != 0) ||
            strlen(token) < 3 || strlen(token) > 4) {
            HAL_UART_Transmit(huart, (uint8_t *)"Invalid Port or Format\n", 24, HAL_MAX_DELAY);
            return -3;
        }

        // Extract port
        GPIO_TypeDef *port = NULL;
        if (strncmp(token, "PA", 2) == 0) {
            port = GPIOA;
        } else if (strncmp(token, "PB", 2) == 0) {
            port = GPIOB;
        } else if (strncmp(token, "PC", 2) == 0) {
            port = GPIOC;
        }

        // Validate pin number (digits only)
        char *pin_str = token + 2; // Skip "PA", "PB", or "PC"
        for (char *c = pin_str; *c; c++) {
            if (!isdigit(*c)) {
                HAL_UART_Transmit(huart, (uint8_t *)"Invalid Pin Format\n", 20, HAL_MAX_DELAY);
                return -3;
            }
        }

        // Convert pin number to integer and validate range
        uint8_t pin_number = atoi(pin_str);
        if (pin_number > 15) {
            HAL_UART_Transmit(huart, (uint8_t *)"Invalid Pin Number\n", 20, HAL_MAX_DELAY);
            return -4;
        }

        // Add the pin to the respective array
        if (port) {
            ((InputPin *)pins_array)[*num_pins].port = port;
            ((InputPin *)pins_array)[*num_pins].pin = 1 << pin_number;
            (*num_pins)++;
        }

        token = strtok(NULL, " ");
    }

    // Send confirmation message
    char confirmation_msg[50];
    snprintf(confirmation_msg, sizeof(confirmation_msg), "%s Pins Configured\n", operation);
    HAL_UART_Transmit(huart, (uint8_t *)confirmation_msg, strlen(confirmation_msg), HAL_MAX_DELAY);
    return 1;
}


/**
 * @brief Handles the input pins and sends their states via UART.
 *
 * This function iterates through all configured input pins, reads their current
 * states (SET or RESET), and sends a formatted message for each pin through UART.
 * It dynamically determines the port name (PA, PB, or PC) and includes it in the
 * response for clarity.
 *
 * Function behavior:
 * - Iterates through the `input_pins` array.
 * - Reads the state of each input pin using `HAL_GPIO_ReadPin`.
 * - Dynamically determines the port name based on the `port` pointer in the `input_pins` array.
 * - Formats a response string with the pin's port, number, and state (SET or RESET).
 * - Sends the response via UART using the provided UART handle.
 *
 * @param huart UART handle used for transmitting the response messages.
 */
void handle_inputs(UART_HandleTypeDef *huart)
{
    // Iterate through all configured input pins, excluding the last pin (to avoid out-of-bounds access)
    for (uint8_t i = 0; i < num_input_pins - 1; i++) {
        // Read the current states of two consecutive input pins
        GPIO_PinState state = HAL_GPIO_ReadPin(input_pins[i].port, input_pins[i].pin);
        GPIO_PinState state_2 = HAL_GPIO_ReadPin(input_pins[i + 1].port, input_pins[i + 1].pin);
        char response[30];
        char response_2[30];

        // Determine the port name for the first pin dynamically
        const char *port_name;
        if (input_pins[i].port == GPIOA) {
            port_name = "PA";
        } else if (input_pins[i].port == GPIOB) {
            port_name = "PB";
        } else if (input_pins[i].port == GPIOC) {
            port_name = "PC";
        } else {
            port_name = "UNKNOWN"; // Handle invalid port cases
        }

        // Format the response string for the first pin
        snprintf(response, sizeof(response), "Pin %s%d: %s\n",
                 port_name,
                 __builtin_ctz(input_pins[i].pin), // Extract pin number from bit position
                 state == GPIO_PIN_SET ? "SET" : "RESET");

        // Determine the port name for the second pin dynamically
        const char *port_name_2;
        if (input_pins[i + 1].port == GPIOA) {
            port_name_2 = "PA";
        } else if (input_pins[i + 1].port == GPIOB) {
            port_name_2 = "PB";
        } else if (input_pins[i + 1].port == GPIOC) {
            port_name_2 = "PC";
        } else {
            port_name_2 = "UNKNOWN"; // Handle invalid port cases
        }

        // Format the response string for the second pin
        snprintf(response_2, sizeof(response_2), "Pin %s%d: %s\n",
                 port_name_2,
                 __builtin_ctz(input_pins[i + 1].pin), // Extract pin number from bit position
                 state_2 == GPIO_PIN_SET ? "SET" : "RESET");

        // Transmit the responses for both pins via UART
        HAL_UART_Transmit(huart, (uint8_t *)response, strlen(response), T_DELAY);
        HAL_UART_Transmit(huart, (uint8_t *)response_2, strlen(response_2), T_DELAY);

        // Evaluate the combined state of the two pins and transmit the result
        if (state == GPIO_PIN_SET) {
            if (state_2 == GPIO_PIN_SET) {
                HAL_UART_Transmit(huart, (uint8_t *)"Out: 11 -> 3", 12, T_DELAY);
            } else if (state_2 == GPIO_PIN_RESET) {
                HAL_UART_Transmit(huart, (uint8_t *)"Out: 10 -> 2", 12, T_DELAY);
            }
        } else if (state == GPIO_PIN_RESET) {
            if (state_2 == GPIO_PIN_SET) {
                HAL_UART_Transmit(huart, (uint8_t *)"Out: 01 -> 1", 12, T_DELAY);
            } else if (state_2 == GPIO_PIN_RESET) {
                HAL_UART_Transmit(huart, (uint8_t *)"Out: 00 -> 0", 12, T_DELAY);
            }
        }
    }
}



/**
 * @brief Sets the state of all configured output pins and provides feedback via UART.
 *
 * This function iterates through the list of configured output pins, sets each pin to the
 * specified state (high or low), and counts the number of pins updated. After processing,
 * it transmits a confirmation message via UART, including the number of pins affected and
 * their new state.
 *
 * Function behavior:
 * - Iterates through the `output_pins` array and sets each pin's state based on the `state` parameter.
 * - Counts the total number of pins successfully updated.
 * - Constructs and transmits a message indicating the count of updated pins and their state.
 *
 * Feedback:
 * - Sends a confirmation message in the format: "<number> State Set - <HIGH/LOW>\n".
 * - The state is derived from the `state` parameter ('1' for HIGH, '0' for LOW).
 *
 * @param huart UART handle used for transmitting confirmation messages.
 * @param state The desired state for the output pins ('1' for high, '0' for low).
 */
void set_output(UART_HandleTypeDef *huart, char state)
{
    int counter = 0;                // Counter to track the number of configured pins
    char message[50];               // Buffer to hold the UART message

    // Iterate through all configured output pins
    for (uint8_t i = 0; i < num_output_pins; i++) {
        // Retrieve the port and pin configuration for the current output pin
        GPIO_TypeDef *port = output_pins[i].port;
        uint16_t gpio_pin = output_pins[i].pin;

        // Set the pin state based on the provided state value
        if (state == '1') {
            // Set the pin to HIGH
            HAL_GPIO_WritePin(port, gpio_pin, GPIO_PIN_SET);
            counter++; // Increment the counter for successfully configured pins
        } else if (state == '0') {
            // Set the pin to LOW
            HAL_GPIO_WritePin(port, gpio_pin, GPIO_PIN_RESET);
            counter++; // Increment the counter for successfully configured pins
        }
    }

    // Construct the message with the counter and state
    snprintf(message, sizeof(message), "%d State Set - %s\n", counter, state == '1' ? "HIGH" : "LOW");

    // Transmit the constructed message via UART
    HAL_UART_Transmit(huart, (uint8_t *)message, strlen(message), T_DELAY);
}



/**
 * @brief Processes and executes commands for GPIO pin configuration and control.
 *
 * This function interprets a received command string and performs actions such as
 * configuring GPIO pins as inputs or outputs, setting the state of output pins,
 * or resetting specific pins. It also validates the input and provides feedback
 * for invalid commands or configurations.
 *
 * Function behavior:
 * - Commands starting with 'd': Configures up to two input pins and processes their states.
 * - Commands starting with 's': Configures output pins, sets their states (high or low),
 *   and provides feedback on the number of pins configured.
 * - Commands with invalid formats or exceeding limits are rejected with appropriate error messages.
 * - Unrecognized commands return an "Unknown Command" message.
 *
 * Command validation:
 * - Ensures proper syntax, valid pin numbers, and acceptable command length for each type.
 * - Rejects malformed commands early to avoid unnecessary processing.
 *
 * @param command The command string received via UART, specifying the action and pins.
 * @param huart   UART handle used for transmitting confirmation, error, or status messages.
 */
void process_command(char *command, UART_HandleTypeDef *huart)
{
    // Check if the command is for configuring input pins (starts with 'd')
	if (strncmp(command, "d", 1) == 0) {
	    // Validate command length to ensure only 2 pins are being configured
	    if (strlen(command) < 9 || strlen(command) > 11) {
	        // If the command length is invalid, send an error message and exit
	        HAL_UART_Transmit(huart, (uint8_t *)"NOK - INVALID INPUT - 2 PINS ONLY", 33, T_DELAY);
	        return; // Exit without further processing
	    }

	    // Attempt to configure the input pins
	    int result_handle = configure_pins(huart, command);
	    if (result_handle == 1) {
	        // If configuration is successful, acknowledge with "OK"
	        HAL_UART_Transmit(huart, (uint8_t *)"OK\n", 3, T_DELAY);
	        // Process and report the state of input pins
	        handle_inputs(huart);
	    } else if (result_handle < 0) {
	        // If configuration failed, send a "NOK" error message
	        HAL_UART_Transmit(huart, (uint8_t *)"NOK\n", 4, T_DELAY);
	    }

	}
    // Check if the command is for configuring output pins (starts with 's')
	else if (strncmp(command, "s", 1) == 0) {
    	// Attempt to configure the output pins
    	int result_set = configure_pins(huart, command);
    	if (result_set == 1) {
            // If configuration is successful, acknowledge with "OK"
            HAL_UART_Transmit(huart, (uint8_t *)"OK\n", 3, HAL_MAX_DELAY);
    	} else if (result_set < 0) {
            // If configuration failed, send a "NOK" error message and exit
            HAL_UART_Transmit(huart, (uint8_t *)"NOK\n", 4, HAL_MAX_DELAY);
            return; // Exit without setting the output state
    	}

		// Extract the desired state ('1' for HIGH or '0' for LOW) from the command
		char state = command[1];
		// Apply the state to all configured output pins
		set_output(huart, state);

    }
	// Check if the command is for resetting all pins (starts with 'r')
	else if (strncmp(command, "r *", 3) == 0){

    	GPIOA->ODR = 0x00; // Reset PortA
    	GPIOB->ODR = 0x00; // Reset PortB
    	GPIOC->ODR = 0x00; // Reset PortC

    	// Confirmation message that all pins have been configured
    	HAL_UART_Transmit(huart, (uint8_t *)"All Pins Have Been Reseted", 26, T_DELAY);
    }
    // If the command does not match 'd' or 's', it is unrecognized
    else {
        // Send an error message indicating the command is unknown
        HAL_UART_Transmit(huart, (uint8_t *)"Unknown Command\n", 17, T_DELAY);
    }
}



