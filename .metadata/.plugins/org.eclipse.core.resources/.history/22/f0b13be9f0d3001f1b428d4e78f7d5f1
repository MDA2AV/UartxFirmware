/**
 * @brief Handles the input pins and sends their states via UART.
 *
 * This function iterates through all configured input pins, reads their current
 * states (SET or RESET), and sends a formatted message for each pin through UART.
 * It dynamically determines the port name (PA, PB, or PC) and includes it in the
 * response for clarity.
 *
 * Function behavior:
 * - Iterates through the `input_pins` array.
 * - Reads the state of each input pin using `HAL_GPIO_ReadPin`.
 * - Dynamically determines the port name based on the `port` pointer in the `input_pins` array.
 * - Formats a response string with the pin's port, number, and state (SET or RESET).
 * - Sends the response via UART using the provided UART handle.
 *
 * @param huart UART handle used for transmitting the response messages.
 */
void handle_inputs(UART_HandleTypeDef *huart)
{
    // Iterate through all configured input pins
    for (uint8_t i = 0; i < num_input_pins; i++) {
        // Read the current state of the input pin
        GPIO_PinState state = HAL_GPIO_ReadPin(input_pins[i].port, input_pins[i].pin);
        char response[30];

        // Determine the port name dynamically
        const char *port_name;
        if (input_pins[i].port == GPIOA) {
            port_name = "PA";
        } else if (input_pins[i].port == GPIOB) {
            port_name = "PB";
        } else if (input_pins[i].port == GPIOC) {
            port_name = "PC";
        } else {
            port_name = "UNKNOWN"; // In case of invalid port
        }

        // Format the response with the port name, pin number, and state
        snprintf(response, sizeof(response), "Pin %s%d: %s\n",
                 port_name,
                 __builtin_ctz(input_pins[i].pin), // Extract pin number from bit position
                 state == GPIO_PIN_SET ? "SET" : "RESET");

        // Send the response via UART
        HAL_UART_Transmit(huart, (uint8_t *)response, strlen(response), T_DELAY);
    }
}



/**
 * @brief Sets the state of a specified output pin.
 *
 * This function identifies the specified output pin by its index, determines the corresponding GPIO
 * port and pin, and sets its state (high or low) based on the provided state value. It also sends a
 * confirmation message via UART.
 *
 * Function behavior:
 * - Converts the provided pin identifier (character) to an integer index.
 * - Validates the pin index against the number of configured output pins.
 * - Sets the state of the pin (high for '1', low for '0') using `HAL_GPIO_WritePin`.
 * - Sends a confirmation message with the pin index and state.
 * - If the pin index is invalid, an error message is sent via UART.
 *
 * @param huart UART handle used for transmitting confirmation or error messages.
 * @param pin   The identifier for the pin, typically a character ('0', '1', etc.).
 * @param state The desired state of the pin ('1' for high, '0' for low).
 */
void set_output(UART_HandleTypeDef *huart, char pin, char state)
{
    // Convert the pin identifier to an integer index
    uint8_t pin_index = pin - '0';

    // Check if the pin index is within the configured range
    if (pin_index < num_output_pins) {
        // Retrieve the port and pin configuration for the specified output pin
        GPIO_TypeDef *port = output_pins[pin_index].port;
        uint16_t gpio_pin = output_pins[pin_index].pin;

        // Set the pin state based on the provided state value
        if (state == '1') {
            HAL_GPIO_WritePin(port, gpio_pin, GPIO_PIN_SET); // Set pin to high
        } else if (state == '0') {
            HAL_GPIO_WritePin(port, gpio_pin, GPIO_PIN_RESET); // Set pin to low
        }

        // Send a confirmation message via UART
        char msg[50];
        sprintf(msg, "Pin %d set to %c\n", pin_index, state);
        HAL_UART_Transmit(huart, (uint8_t *)msg, strlen(msg), T_DELAY);
    } else {
        // Send an error message if the pin index is invalid
        HAL_UART_Transmit(huart, (uint8_t *)"Invalid Pin Index\n", 19, T_DELAY);
    }
}



/**
 * @brief Resets the state of output pins.
 *
 * This function resets the state of either a specific output pin or all configured output pins.
 * If a pin name is provided, it searches for the pin in the `output_pins` array and resets its state.
 * If no pin name is provided, it resets the state of all configured output pins. A confirmation
 * message is sent via UART for each action.
 *
 * Function behavior:
 * - If a specific pin is provided, the function searches for it in the `output_pins` array.
 * - If the pin is found, it resets its state and sends a confirmation message.
 * - If the pin is not found, it sends an error message.
 * - If no specific pin is provided, it resets the state of all output pins and sends a confirmation message.
 *
 * @param huart         UART handle used for transmitting confirmation or error messages.
 * @param pin_to_reset  Pointer to a string representing the pin name (e.g., "PC8").
 *                      If `NULL`, all output pins are reset.
 *
 * RESET ALL PINS -> NOT WORKING YET
 *
 */
void reset_output_pins(UART_HandleTypeDef *huart, char *pin_to_reset)
{
    bool pin_found = false;

    // Check if a specific pin name is provided
    if (pin_to_reset != NULL) {
        // Iterate through all configured output pins
        for (uint8_t i = 0; i < num_reset_pins; i++) {
            const char *port_name;

            // Determine the port name dynamically
            if (reset_pins[i].port == GPIOA) {
                port_name = "PA";
            } else if (reset_pins[i].port == GPIOB) {
                port_name = "PB";
            } else if (reset_pins[i].port == GPIOC) {
                port_name = "PC";
            } else {
                port_name = "UNKNOWN";
            }

            // Generate the pin name dynamically
            char pin_name[10];
            sprintf(pin_name, "%s%d", port_name, __builtin_ctz(reset_pins[i].pin));

            // Compare with the provided pin name
            if (strcmp(pin_name, pin_to_reset) == 0) {
                // Reset the specific pin
                HAL_GPIO_WritePin(reset_pins[i].port, reset_pins[i].pin, GPIO_PIN_RESET);
                pin_found = true;

                // Confirmation message
                char msg[50];
                sprintf(msg, "Pin %s Reset\n", pin_to_reset);
                HAL_UART_Transmit(huart, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
                break;
            }
        }

        // If no match is found
        if (!pin_found) {
            HAL_UART_Transmit(huart, (uint8_t *)"Pin not found\n", 15, HAL_MAX_DELAY);
        }
    } else {
        // Reset all pins if no specific pin is provided
        HAL_UART_Transmit(huart, (uint8_t *)"Resetting all pins...\n", 23, HAL_MAX_DELAY);
        for (uint8_t i = 0; i < num_reset_pins; i++) {
            HAL_GPIO_WritePin(reset_pins[i].port, reset_pins[i].pin, GPIO_PIN_RESET);
        }
        HAL_UART_Transmit(huart, (uint8_t *)"All Output Pins Reset\n", 23, HAL_MAX_DELAY);
    }
}



/**
 * @brief Processes a received command and performs the appropriate action.
 *
 * This function interprets the incoming command string and executes the corresponding
 * action, such as configuring input/output pins, setting output states, or resetting pins.
 * It also provides error feedback for unrecognized commands.
 *
 * Function behavior:
 * - Commands starting with 'd': Configure and handle input pins.
 * - Commands starting with 's': Configure output pins and optionally set their state.
 * - Commands starting with 'r': Reset the state of specified or all output pins.
 * - Any other command: Sends an "Unknown Command" message.
 *
 * @param command The command string received via UART.
 * @param huart   UART handle used for transmitting responses or error messages.
 */
void process_command(char *command, UART_HandleTypeDef *huart)
{
    // Check if the command is for configuring input pins
    if (strncmp(command, "d", 1) == 0) {
        configure_input_pins(command); // Configure input pins
        handle_inputs(huart);          // Handle and report input pin states

    } else if (strncmp(command, "s", 1) == 0) {
        configure_output_pins(huart, command); // Configure output pins

        // Extract pin index and desired state from the command
        if (strlen(command) >= 4) { // Ensure the command has enough length
            char pin = command[1];   // Extract the pin index (e.g., '0', '1')
            char state = command[2]; // Extract the desired state ('1' or '0')
            set_output(huart, pin, state); // Set the output state
        }

    } else if (strncmp(command, "r", 1) == 0) {
    	configure_reset_pins(command); // Configure reset pins
        // Handle reset command
        char *pin_to_reset = strtok(command + strlen("r "), " "); // Extract pin to reset
        reset_output_pins(huart, pin_to_reset); // Reset specified or all pins

    } else {
        // Send error message for unrecognized commands
        HAL_UART_Transmit(huart, (uint8_t *)"Unknown Command\n", 17, T_DELAY);
    }
}



