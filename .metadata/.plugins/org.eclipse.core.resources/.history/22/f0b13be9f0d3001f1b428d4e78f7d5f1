}



/**
 * @brief Configures the pins to be reset based on the provided command.
 *
 * This function parses the command string to identify and configure the pins
 * that should be reset. It stores the pin configurations in the `reset_pins` array.
 *
 * - The function assumes that the command string starts with "r " followed by
 *   pin names (e.g., "r PC8 PA9").
 * - It supports GPIO ports: GPIOA, GPIOB, and GPIOC.
 * - Each pin configuration is validated to ensure the pin number is between 0 and 15.
 *
 * Function behavior:
 * - Resets the `reset_pins` list by setting `num_reset_pins` to 0.
 * - Parses the command to extract pin names and validates them.
 * - If the pin is valid, it adds the configuration (port and pin) to the `reset_pins` array.
 *
 * @param command The input string containing the reset command and pin names.
 *
 * @note The array `reset_pins` and the variable `num_reset_pins` must be defined
 *       and initialized elsewhere in the program. Ensure `MAX_RESET_PINS` is set
 *       to the maximum number of resettable pins.
 */
void configure_reset_pins(char *command)
{
    num_reset_pins = 0; // Reset the input pin list

    char *token_r = strtok(command + strlen("r "), " ");
    while (token_r && num_reset_pins < MAX_RESET_PINS) {
        if (strncmp(token_r, "PC", 2) == 0) { // For GPIOC
            uint8_t pin_number = atoi(token_r + 2);
            if (pin_number <= 15) { // Validate pin number
                reset_pins[num_reset_pins].port = GPIOC;
                reset_pins[num_reset_pins].pin = 1 << pin_number;
                num_reset_pins++;
            }
        } else if (strncmp(token_r, "PA", 2) == 0) { // For GPIOC
            uint8_t pin_number = atoi(token_r + 2);
            if (pin_number <= 15) { // Validate pin number
            	reset_pins[num_reset_pins].port = GPIOA;
            	reset_pins[num_reset_pins].pin = 1 << pin_number;
            	num_reset_pins++;
            }
        } else if (strncmp(token_r, "PB", 2) == 0) { // For GPIOC
            uint8_t pin_number = atoi(token_r + 2);
            if (pin_number <= 15) { // Validate pin number
            	reset_pins[num_reset_pins].port = GPIOB;
