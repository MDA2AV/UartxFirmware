 * @param command The command string specifying the output pins to configure.
 *                Example: "s PA3 PB5 PC7".
 */
void configure_output_pins(UART_HandleTypeDef *huart, char *command)
{
    num_output_pins = 0; // Reset the output pin list

    // Tokenize the command string to extract pin configurations
    char *token_o = strtok(command + strlen("s  "), " ");

    while (token_o && num_output_pins < MAX_OUTPUT_PINS) {
        if (strncmp(token_o, "PC", 2) == 0) { // For GPIOC
            uint8_t pin_number = atoi(token_o + 2); // Extract pin number
            if (pin_number <= 15) { // Validate pin number
                output_pins[num_output_pins].port = GPIOC;
                output_pins[num_output_pins].pin = 1 << pin_number;
                num_output_pins++;
            }
        } else if (strncmp(token_o, "PA", 2) == 0) { // For GPIOA
            uint8_t pin_number = atoi(token_o + 2); // Extract pin number
            if (pin_number <= 15) { // Validate pin number
                output_pins[num_output_pins].port = GPIOA;
                output_pins[num_output_pins].pin = 1 << pin_number;
                num_output_pins++;
            }
        } else if (strncmp(token_o, "PB", 2) == 0) { // For GPIOB
            uint8_t pin_number = atoi(token_o + 2); // Extract pin number
